# Copy to .env.production (never commit it) and fill in. Used by docker-compose.prod.yml.
# Leave optional settings commented out rather than empty: an empty value counts as missing.

# Public URL of the app, e.g. https://app.example.com (links in emails, CORS).
APP_URL=

# Letters and digits only: it goes into the database URL unescaped.
POSTGRES_PASSWORD=

# Long random string, e.g. `openssl rand -hex 32`.
JWT_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=appointment-reminder

# brevo sends real email; log only prints it.
MAIL_PROVIDER=brevo
# Must be a sender verified in Brevo.
MAIL_FROM_EMAIL=
# MAIL_FROM_NAME=ShowUp
BREVO_API_KEY=

# Optional, with their defaults:
# JWT_ACCESS_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30
# INVITE_TTL_DAYS=7
# QUEUE_PREFIX=appointment-reminder
